# Eleventy: installed packages and the built site. Both rebuild from the source.
node_modules/
_site/

# Python caches
__pycache__/
*.pyc

# Settings that belong to this computer only
.claude/settings.local.json
Webpages/.vscode/

# Compiled programs. Rebuild them from the .cpp files.
*.exe

# Office lock files, Windows and OneDrive clutter
~$*
Thumbs.db
desktop.ini
*.tmp

